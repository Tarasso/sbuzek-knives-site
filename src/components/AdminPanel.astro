---
import siteContent from "../content/site.json";
---

<section class="admin-page" data-admin-panel>
	<section class="admin-section admin-login" data-login-view hidden>
		<p class="eyebrow">Administrator</p>
		<h1>Sign in</h1>
		<form class="knife-form" data-password-form>
			<label class="admin-field">
				<span>Password</span>
				<input name="password" type="password" minlength="20" required autocomplete="current-password" />
			</label>
			<p class="admin-message admin-error" data-login-error role="alert" hidden></p>
			<div class="form-actions">
				<button class="button-link" type="submit" data-password-submit>Sign in</button>
				<a class="admin-login-link" href="/login">Use Microsoft sign-in</a>
			</div>
		</form>
	</section>
	<div data-admin-app hidden>
	<div class="admin-bar">
		<p>Signed in as <strong data-user-name>Checking sign-in...</strong></p>
		<div class="admin-bar-links">
			<a href="/">View site</a>
			<button type="button" data-sign-out>Sign out</button>
		</div>
	</div>

	<section class="admin-section" aria-labelledby="biography-form-title">
		<div class="admin-heading">
			<div>
				<p class="eyebrow">Homepage</p>
				<h1 id="biography-form-title">About Stanley</h1>
			</div>
		</div>
		<form class="knife-form" data-biography-form>
			<label class="admin-field">
				<span>Biography</span>
				<textarea name="biography" maxlength="12000" rows="14" required>{siteContent.biography}</textarea>
			</label>
			<p class="admin-message" data-biography-message aria-live="polite"></p>
			<div class="form-actions">
				<button class="button-link" type="submit" data-biography-save>Save biography</button>
			</div>
		</form>
	</section>

	<section class="admin-section" data-list-view>
		<div class="admin-heading">
			<div>
				<p class="eyebrow">Catalog</p>
				<h1>My knives</h1>
			</div>
			<div class="admin-heading-actions">
				<label class="file-picker" data-folder-picker>
					<span>Upload photo folder</span>
					<input data-folder-input type="file" accept="image/*" multiple webkitdirectory />
				</label>
				<button class="button-link" type="button" data-add-knife>Add a knife</button>
			</div>
		</div>
		<p class="admin-message" data-list-message aria-live="polite">Loading your knives...</p>
		<div class="upload-status" data-bulk-status role="status" aria-live="polite" hidden>
			<p data-bulk-message></p>
			<progress max="100" value="0" data-bulk-progress></progress>
		</div>
		<div class="admin-order-controls">
			<p class="admin-message" data-order-message aria-live="polite"></p>
			<button class="quiet-button" type="button" data-order-save disabled>Save gallery order</button>
		</div>
		<ul class="admin-piece-list" data-piece-list></ul>
	</section>

	<section class="admin-section" data-form-view hidden>
		<div class="admin-heading">
			<div>
				<p class="eyebrow" data-form-eyebrow>New catalog entry</p>
				<h1 data-form-title>Add a knife</h1>
			</div>
		</div>
		<form class="knife-form" data-knife-form>
			<label class="admin-field">
				<span>Title</span>
				<input name="title" maxlength="120" required autocomplete="off" />
			</label>
			<label class="admin-field">
				<span>Description</span>
				<textarea name="description" maxlength="4000" rows="6"></textarea>
			</label>
			<fieldset class="admin-field photo-field">
				<legend>Photos <span class="field-hint">Up to 12</span></legend>
				<label class="file-picker">
					<span>Add photos</span>
					<input data-photo-input type="file" accept="image/*" multiple />
				</label>
				<ol class="selected-photo-list" data-selected-photos></ol>
			</fieldset>
			<label class="admin-field">
				<span>Show as</span>
				<select name="status">
					<option value="gallery">On site</option>
					<option value="available">For sale</option>
					<option value="hidden">Hidden</option>
				</select>
			</label>
			<label class="admin-field" data-price-field hidden>
				<span>Price / note <span class="field-hint">Optional</span></span>
				<input name="priceNote" maxlength="200" autocomplete="off" placeholder="Email for price" />
			</label>
			<label class="check-field">
				<input name="featured" type="checkbox" />
				<span>Show on home page</span>
			</label>
			<div class="upload-status" data-upload-status role="status" aria-live="polite" hidden>
				<p data-upload-message></p>
				<progress max="100" value="0" data-upload-progress></progress>
			</div>
			<p class="admin-message admin-error" data-form-error role="alert" hidden></p>
			<div class="form-actions">
				<button class="button-link" type="submit" data-save-button>Save knife</button>
				<button class="quiet-button" type="button" data-cancel>Cancel</button>
				<button class="danger-button" type="button" data-delete-piece hidden>Delete permanently</button>
			</div>
		</form>
	</section>
	</div>
</section>

<script src="../lib/admin.ts"></script>