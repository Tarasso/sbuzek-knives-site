---
import GalleryView from "../components/GalleryView.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="S. Buzek Knives | Handmade knives from Caldwell, Texas" description="Handmade knives by Stanley Buzek of Caldwell, Texas.">
	<section class="home-intro">
		<p class="eyebrow">Caldwell, Texas</p>
		<h1>S. Buzek<br /><em>Knives</em></h1>
		<p class="intro-copy">Handmade knives by Stanley Buzek.</p>
		<nav class="intro-links" aria-label="Explore">
			<a class="text-link" href="/gallery">Explore the gallery <span aria-hidden="true">&rarr;</span></a>
			<a class="text-link" href="/available">Knives for sale <span aria-hidden="true">&rarr;</span></a>
		</nav>
	</section>

	<section class="catalog-section" aria-labelledby="featured-title">
		<div class="section-heading">
			<div>
				<p class="eyebrow">Selected work</p>
				<h2 id="featured-title">From the shop</h2>
			</div>
			<a class="text-link" href="/gallery">All knives <span aria-hidden="true">&rarr;</span></a>
		</div>
		<GalleryView mode="featured" />
	</section>
</SiteLayout>
